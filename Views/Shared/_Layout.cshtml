<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fieldnotes AI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="AI" asp-action="Index" aria-label="Fieldnotes AI home">
            <span class="brand-mark" aria-hidden="true">F</span>
            <span>Fieldnotes <span class="brand-light">AI</span></span>
        </a>
        <span class="topbar-note">A quiet place to think things through</span>
    </header>
    <main class="page-shell">
        @RenderBody()
    </main>
    <footer class="footer">Responses are generated by AI and may need verification.</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>